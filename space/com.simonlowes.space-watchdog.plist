<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.simonlowes.space-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/simon/.local/bin/space-watchdog.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>StandardOutPath</key>
    <string>/Users/simon/.local/share/space-wallpaper/watchdog-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/simon/.local/share/space-wallpaper/watchdog-stderr.log</string>
</dict>
</plist>
